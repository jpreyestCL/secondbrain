# URL pública del gateway (la URL del túnel cuando esté expuesto).
# En desarrollo local puede omitirse (usa http://127.0.0.1:8787).
BASE_URL=https://tu-tunel.trycloudflare.com

# Secreto para firmar cookies y tokens. Genera uno con: openssl rand -hex 32
AUTH_SECRET=

# URL del servidor MCP de Graphiti del PRIMER dueño. Solo se usa como
# semilla del mapeo en tenants.json al ejecutar `npm run create-owner`.
# El endpoint /mcp NUNCA usa este valor como fallback: el enrutamiento
# multi-tenant sale siempre de tenants.json.
GRAPHITI_MCP_URL=http://127.0.0.1:8020/mcp

# Registro de tenants (usuario -> upstream MCP). Por defecto gateway/tenants.json
# TENANTS_FILE=/ruta/a/tenants.json

# Puerto e interfaz local del gateway.
PORT=8787
HOST=127.0.0.1

# Endpoint HTTP público de sign-up de Better Auth (/api/auth/sign-up/*).
# Déjalo en false: el dueño se crea con `npm run create-owner -- correo clave`
# y las altas de gente van por /registro. NO afecta a /registro.
ALLOW_SIGNUP=false

# --- Registro self-service (/registro) ---

# Modo de registro. Default: open.
#   open   => cualquiera crea cuenta SIN código (también con Google).
#   invite => hace falta REGISTRATION_CODE (también para Google).
#   closed => /registro responde 403 y Google no aprovisiona a nadie nuevo.
# Compatibilidad: si NO defines REGISTRATION_MODE pero sí REGISTRATION_CODE,
# el modo efectivo es `invite` (el comportamiento anterior).
REGISTRATION_MODE=open

# Código de invitación. Solo se usa con REGISTRATION_MODE=invite.
# Genera uno con: openssl rand -hex 16 . Rótalo periódicamente.
REGISTRATION_CODE=

# VÁLVULA DE SEGURIDAD: tope duro de tenants (default 5). Antes de crear
# ninguna cuenta se cuentan las entradas de tenants.json; al alcanzar el tope
# el registro se cierra temporalmente (503) sin crear usuario ni aprovisionar.
#
# Por qué importa: el servidor tiene ~1 GB de RAM libre y el MCP de cada tenant
# corre con MemoryMax=500M, así que un registro abierto sin tope puede dejar la
# máquina sin memoria — y en ese mismo equipo viven las apps de producción del
# dueño. Súbelo solo cuando haya RAM que lo respalde.
MAX_TENANTS=5

# Raíz del repo del second brain (contiene infra/). Relativa a gateway/ o
# absoluta. Default: .. (el repo padre de gateway/).
# BRAIN_REPO_ROOT=..

# Comando de aprovisionamiento del tenant (se ejecuta con cwd=BRAIN_REPO_ROOT).
# {slug} y {port} se sustituyen; sin placeholders se agregan como argumentos.
# PROVISION_CMD=bash infra/scripts/provision-tenant.sh {slug} {port}

# Primer puerto MCP considerado al asignar puerto a un tenant nuevo.
# TENANT_PORT_BASE=9021

# Máximo de POST /registro por IP por minuto (rate limit en memoria).
# El alta por Google (/post-google) usa el MISMO limitador.
# REGISTRO_RATE_LIMIT=5

# Máximo de registros de cliente OAuth (DCR, /api/auth/mcp/register) por IP/min.
# DCR_RATE_LIMIT=20

# --- "Continuar con Google" (OPCIONAL) ---
# Credenciales del OAuth 2.0 Client ID (tipo "Web application") de Google Cloud
# Console. Si falta CUALQUIERA de las dos, Google se deshabilita por completo
# (sin botón, sin proveedor social; no hay crash). Ver "Habilitar Google" en
# README.md. El URI de redirección autorizado a registrar en Google es:
#   <BASE_URL>/api/auth/callback/google
# p. ej. https://mybrain.rlz.cl/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Sesiones del navegador (cookie de Better Auth) ---

# Duración de la cookie de sesión en días. Default 2 (antes eran 7 fijos).
# Con la rotación de abajo, la actividad renueva la expiración, así que un
# valor corto no obliga a reloguearse a quien lo usa a diario.
# SESSION_MAX_AGE_DAYS=2

# Cada cuántos minutos de uso se refresca la expiración de la sesión.
# Default 60. 0 => se refresca en cada petición (más escrituras en SQLite).
# SESSION_UPDATE_AGE_MINUTES=60

# --- Exportación de la memoria (GET /export) ---

# Topes de lo que /export pide al MCP del tenant. Subirlos hace la descarga
# más completa y más lenta.
# EXPORT_MAX_EPISODES=1000
# EXPORT_MAX_NODES=500
