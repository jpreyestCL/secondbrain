{
  "name": "secondbrain-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OAuth 2.1 gateway (Better Auth MCP plugin) que expone el servidor MCP local de Graphiti como conector remoto para claude.ai",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "create-owner": "tsx scripts/create-owner.ts",
    "add-user": "tsx scripts/add-user.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "better-auth": "1.6.26",
    "better-sqlite3": "12.11.1",
    "dotenv": "17.4.2",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.9.5",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
