# PLANTILLA — no editar el original a mano.
# provision-tenant-native.sh la copia por tenant sustituyendo
# __MCP_HOST__ y __MCP_PORT__. Se genera desde infra/graphiti/config.yaml,
# asi que cualquier cambio de variables (LLM_*, EMBEDDER_*) llega aqui.
# Config del Graphiti MCP server (montado en /app/mcp/config/config.yaml).
# Derivado de mcp_server/config/config-docker-falkordb.yaml del repo getzep/graphiti
# (version graphiti 0.28.2 / imagen 1.0.2). La sintaxis ${VAR:default} la resuelve
# el loader de configuracion del propio server contra las variables de entorno.

server:
  transport: "http"          # streamable HTTP; endpoint MCP en /mcp/
  host: "__MCP_HOST__"
  port: __MCP_PORT__

llm:
  provider: ${LLM_PROVIDER:openai}
  # Modelo de CHAT. Variable propia (LLM_MODEL) para poder alternar de proveedor
  # sin tocar la config de NVIDIA que vive en MODEL_NAME/OPENAI_*.
  model: ${LLM_MODEL}
  max_tokens: 4096

  providers:
    openai:
      # Credenciales del CHAT, independientes de las del embedder. Esto permite
      # tener, a la vez: chat en OpenAI (gpt-4o-mini) y embeddings en NVIDIA
      # (nv-embed-v1, 4096 dims), que es lo que exige un grafo ya indexado.
      api_key: ${LLM_API_KEY}
      api_url: ${LLM_API_URL:https://api.openai.com/v1}
      organization_id: ${OPENAI_ORGANIZATION_ID:}

    anthropic:
      api_key: ${ANTHROPIC_API_KEY}
      api_url: ${ANTHROPIC_API_URL:https://api.anthropic.com}
      max_retries: 3

embedder:
  provider: ${EMBEDDER_PROVIDER:openai}
  model: ${EMBEDDER_MODEL:text-embedding-3-small}
  dimensions: ${EMBEDDER_DIMENSIONS:1536}

  providers:
    openai:
      # Clave PROPIA del embedder (OBLIGATORIA si se define): permite chat en un
      # proveedor (p.ej. OpenAI gpt-4o-mini) y embeddings en otro (NVIDIA
      # nv-embed-v1, 4096 dims). El loader NO soporta ${VAR:${OTRA}} anidado, asi
      # que hay que fijarla explicitamente en mcp.env.
      # OJO: cambiar el proveedor/dimension de embeddings de un grafo existente
      # CORROMPE la busqueda semantica.
      api_key: ${EMBEDDER_API_KEY}
      # URL propia del embedder: permite LLM=DeepSeek (sin embeddings) +
      # embeddings en Ollama u OpenAI. Si no se define, api.openai.com.
      api_url: ${EMBEDDER_API_URL:https://api.openai.com/v1}
      organization_id: ${OPENAI_ORGANIZATION_ID:}

    voyage:
      api_key: ${VOYAGE_API_KEY}
      api_url: ${VOYAGE_API_URL:https://api.voyageai.com/v1}
      model: "voyage-3"

database:
  provider: "falkordb"

  providers:
    falkordb:
      uri: ${FALKORDB_URI:redis://falkordb:6379}
      password: ${FALKORDB_PASSWORD:}
      database: ${FALKORDB_DATABASE:default_db}

graphiti:
  group_id: ${GRAPHITI_GROUP_ID:main}
  episode_id_prefix: ${EPISODE_ID_PREFIX:}
  user_id: ${USER_ID:mcp_user}
  entity_types:
    - name: "Preference"
      description: "User preferences, choices, opinions, or selections (PRIORITIZE over most other types except User/Assistant)"
    - name: "Requirement"
      description: "Specific needs, features, or functionality that must be fulfilled"
    - name: "Procedure"
      description: "Standard operating procedures and sequential instructions"
    - name: "Location"
      description: "Physical or virtual places where activities occur"
    - name: "Event"
      description: "Time-bound activities, occurrences, or experiences"
    - name: "Organization"
      description: "Companies, institutions, groups, or formal entities"
    - name: "Document"
      description: "Information content in various forms (books, articles, reports, etc.)"
    - name: "Topic"
      description: "Subject of conversation, interest, or knowledge domain (use as last resort)"
    - name: "Object"
      description: "Physical items, tools, devices, or possessions (use as last resort)"
