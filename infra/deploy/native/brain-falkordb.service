[Unit]
Description=Second Brain FalkorDB (redis8+graph module, port 6380)
After=network-online.target
Wants=network-online.target

[Service]
User=secondbrain
Group=secondbrain
Type=simple
ExecStart=/opt/secondbrain-native/bin/redis-server /opt/secondbrain-native/falkordb.conf
Restart=always
RestartSec=3
MemoryMax=700M
OOMScoreAdjust=500
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/secondbrain-native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
