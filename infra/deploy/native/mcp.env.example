# PLANTILLA de /opt/secondbrain-native/mcp.env — env COMPARTIDO de los MCP.
# Copiar a /opt/secondbrain-native/mcp.env (chown secondbrain, chmod 600) y
# rellenar los secretos. NUNCA commitear el archivo real.
#
# Los units brain-mcp@<slug> cargan PRIMERO este archivo y DESPUES
# tenants/<slug>.env, que pisa FALKORDB_URI / FALKORDB_DATABASE /
# GRAPHITI_GROUP_ID / CONFIG_PATH. O sea: aqui va lo comun (LLM, embedder,
# API keys), alla lo propio de cada tenant.

# --- Conexion a FalkorDB (valores del tenant base; los tenants la pisan) ------
# La auth va embebida en la URI con el usuario ACL propio, NO con el admin.
FALKORDB_URI=redis://tenant_ejemplo:CAMBIAR@127.0.0.1:6380
# Vacio a proposito: el server usa las credenciales de la URI.
FALKORDB_PASSWORD=
FALKORDB_DATABASE=ejemplo
GRAPHITI_GROUP_ID=ejemplo

# --- Graphiti -----------------------------------------------------------------
GRAPHITI_TELEMETRY_ENABLED=false
# Concurrencia de extraccion. Subirlo consume mas RAM y mas cuota del LLM.
SEMAPHORE_LIMIT=6
# El server lee su config (incluido EL PUERTO) de este YAML.
CONFIG_PATH=/opt/secondbrain-native/mcp/config/config.yaml

# --- LLM de extraccion: NVIDIA NIM (API compatible OpenAI, cero RAM local) ----
LLM_PROVIDER=openai
MODEL_NAME=meta/llama-3.1-70b-instruct
OPENAI_API_KEY=nvapi-CAMBIAR
OPENAI_API_URL=https://integrate.api.nvidia.com/v1

# --- Embeddings ---------------------------------------------------------------
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=nvidia/nv-embed-v1
EMBEDDER_API_URL=https://integrate.api.nvidia.com/v1
EMBEDDER_DIMENSIONS=4096
