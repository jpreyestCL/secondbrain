[Unit]
Description=Second Brain OAuth gateway (mybrain.rlz.cl)
After=network-online.target brain-mcp.service
Wants=network-online.target

[Service]
User=secondbrain
Group=secondbrain
Type=simple
WorkingDirectory=/opt/secondbrain-native/gateway
EnvironmentFile=/opt/secondbrain-native/gateway/.env
Environment=HOME=/opt/secondbrain-native
Environment=BRAIN_REPO_ROOT=/opt/secondbrain-native
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
MemoryMax=250M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/secondbrain-native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
