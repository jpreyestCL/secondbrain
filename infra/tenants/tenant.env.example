# Plantilla de tenant del "second brain".
# Copiar a infra/tenants/<nombre>.env (un archivo por tenant) o, mejor,
# usar:  make add-tenant NAME=<nombre> PORT=<puerto>
#
# TENANT_NAME y MCP_PORT los lee el generador (gen-tenants-compose.sh);
# el resto se inyecta como entorno al contenedor MCP del tenant.

# Nombre del tenant: [a-z0-9_-], debe coincidir con el nombre del archivo.
TENANT_NAME=ejemplo

# Puerto en el host (loopback) para este MCP server: 8021, 8022, ...
# Unico por tenant. El gateway OAuth enruta al usuario a este puerto.
MCP_PORT=8029

# Grafo PROPIO del tenant dentro de la instancia FalkorDB compartida.
# Convencion: grafo == tenant (el group_id de Graphiti nombra el grafo).
FALKORDB_DATABASE=ejemplo

# Namespace de Graphiti dentro del grafo (basta con el nombre del tenant).
GRAPHITI_GROUP_ID=ejemplo

# Password del usuario ACL tenant_<nombre> en FalkorDB (segunda capa de
# aislamiento: ese usuario solo puede tocar el grafo del tenant).
# Generar con: openssl rand -hex 24
FALKORDB_TENANT_PASSWORD=cambiar-por-un-password-generado

# Opcional: sobreescribir por tenant los ajustes de LLM/embedder del .env raiz
# (p. ej. un tenant con Ollama local y otro con OpenAI).
# LLM_PROVIDER=openai
# MODEL_NAME=gpt-5.5
# SEMAPHORE_LIMIT=10
