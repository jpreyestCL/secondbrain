# =============================================================================
# second brain — variables de entorno
# Copiar a .env en la raiz del repo:  cp .env.example .env
# El Makefile pasa este archivo a docker compose con --env-file.
# NUNCA commitear el .env real (contiene claves).
# =============================================================================

# --- FalkorDB ----------------------------------------------------------------

# Password de FalkorDB. Vacio = sin autenticacion (aceptable porque el puerto
# 6379 solo escucha en 127.0.0.1). Si lo defines, el MCP server lo usa tambien.
FALKORDB_PASSWORD=

# NOTA multi-tenant: el grafo (FALKORDB_DATABASE=brain_<tenant>) y el
# GRAPHITI_GROUP_ID se definen POR TENANT en infra/tenants/<nombre>.env,
# no aqui. Este archivo solo lleva lo compartido (claves, LLM, embeddings).

# --- Graphiti (grafo de conocimiento) ----------------------------------------

# Maximo de operaciones LLM concurrentes dentro del server. Subirlo acelera la
# ingesta pero puede topar rate limits del proveedor. Recomendado: 10.
SEMAPHORE_LIMIT=10

# --- LLM (extraccion de entidades/relaciones) --------------------------------

# Proveedor de LLM: openai | anthropic
# Con "openai" tambien puedes usar Ollama u otro endpoint compatible con la
# API de OpenAI (ver OPENAI_API_URL mas abajo).
LLM_PROVIDER=openai

# Modelo de LLM a usar por el proveedor elegido.
# Ej OpenAI: gpt-5.5 | Ej Ollama: llama3.1:8b
MODEL_NAME=gpt-5.5

# Clave de OpenAI. Requerida si LLM_PROVIDER=openai y/o para embeddings.
# Con Ollama local puedes poner cualquier valor no vacio (ej: "ollama").
OPENAI_API_KEY=

# URL base de la API OpenAI-compatible. Para Ollama corriendo en el Mac:
#   OPENAI_API_URL=http://host.docker.internal:11434/v1
OPENAI_API_URL=https://api.openai.com/v1

# Clave de Anthropic. Opcional; solo si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Embeddings --------------------------------------------------------------

# Proveedor de embeddings: openai | voyage
# (con "openai" + OPENAI_API_URL puedes usar un servidor de embeddings local
#  compatible con OpenAI, ej: Ollama con nomic-embed-text)
EMBEDDER_PROVIDER=openai

# Modelo de embeddings (1536 dimensiones esperadas por la config por defecto).
EMBEDDER_MODEL=text-embedding-3-small

# Clave de Voyage AI. Opcional; solo si EMBEDDER_PROVIDER=voyage.
VOYAGE_API_KEY=
